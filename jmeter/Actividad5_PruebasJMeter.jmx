          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assertion - Respuesta es lista JSON" enabled="true">
            <stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[
try {
    def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if (!(body instanceof List)) throw new Exception('La respuesta no es una lista JSON.')
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Carga ligera: ' + e.getMessage())
}
]]></stringProp>
